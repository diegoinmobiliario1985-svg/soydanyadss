# ─────────────────────────────────────────────
# CONFIGURACIÓN GENERAL
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL base pública de la app (sin barra final).
# En local: http://localhost:3000
# En Railway: https://TU-APP.up.railway.app
BASE_URL=http://localhost:3000

# ─────────────────────────────────────────────
# AUTENTICACIÓN JWT
# ─────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_seguro_min_32_chars

# ─────────────────────────────────────────────
# STRIPE (obtener en dashboard.stripe.com)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA_AQUI
STRIPE_PUBLISHABLE_KEY=pk_test_TU_CLAVE_PUBLICA_AQUI
STRIPE_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET_AQUI

# ─────────────────────────────────────────────
# EMAIL (SMTP - usar Gmail con App Password)
# ─────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=hola@danyads.com
EMAIL_PASS=tu_app_password_de_gmail

# ─────────────────────────────────────────────
# ADMIN POR DEFECTO (se crea al iniciar el servidor)
